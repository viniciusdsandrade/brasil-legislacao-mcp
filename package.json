{
  "name": "leis-mcp",
  "version": "0.3.0",
  "description": "MCP server to search, read and cite the Brazilian legislation corpus viniciusdsandrade/leis from a local, read-only clone.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "legislacao",
    "leis",
    "direito",
    "brasil",
    "claude-code"
  ],
  "author": "Vinícius Andrade",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciusdsandrade/brasil-legislacao-mcp.git"
  },
  "homepage": "https://github.com/viniciusdsandrade/brasil-legislacao-mcp#readme",
  "bugs": {
    "url": "https://github.com/viniciusdsandrade/brasil-legislacao-mcp/issues"
  },
  "type": "module",
  "bin": {
    "leis-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
